{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "journal.5dailywords.com" }],
      "destination": "/journal/index.html"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "journal.5dailywords.com" }],
      "destination": "/journal/privacy/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
