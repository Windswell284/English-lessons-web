{
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "journal.5dailywords.com" }],
      "dest": "/journal/index.html"
    },
    {
      "src": "/privacy",
      "has": [{ "type": "host", "value": "journal.5dailywords.com" }],
      "dest": "/journal/privacy/index.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
